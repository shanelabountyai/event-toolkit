{
  "name": "event-toolkit",
  "private": true,
  "version": "0.1.0",
  "description": "Event Planner Productivity Suite — monorepo root (PRD 1: Event Brief Generator)",
  "scripts": {
    "preflight": "if [ -x \"$HOME/.claude/bin/swapcheck\" ]; then \"$HOME/.claude/bin/swapcheck\" --quiet; fi",
    "dev": "pnpm preflight && pnpm --filter @event-toolkit/web dev",
    "build": "pnpm -r --filter @event-toolkit/web... build",
    "start": "pnpm --filter @event-toolkit/web start",
    "lint": "pnpm --filter @event-toolkit/web lint",
    "typecheck": "pnpm -r typecheck",
    "fixtures:generate": "node scripts/make-fixtures.mjs",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "sanity": "tsx scripts/sanity-check.ts",
    "store-check": "tsx scripts/store-check.ts",
    "promo-check": "tsx scripts/promo-check.ts",
    "verify": "pnpm clean:stale && pnpm typecheck && pnpm lint && pnpm validate:fixtures && pnpm sanity && pnpm store-check && pnpm promo-check && pnpm logistics-check && pnpm budget-check && pnpm leads-check && pnpm roi-check && pnpm retro-check && pnpm calibration-check && pnpm access-check  && pnpm db-schema-check && pnpm workspace-store-check && pnpm sync-check && pnpm pii-check && pnpm server-db-check && pnpm build",
    "logistics-check": "tsx scripts/logistics-check.ts",
    "budget-check": "tsx scripts/budget-check.ts",
    "leads-check": "tsx scripts/leads-check.ts",
    "roi-check": "tsx scripts/roi-check.ts",
    "retro-check": "tsx scripts/retro-check.ts",
    "calibration-check": "tsx scripts/calibration-check.ts",
    "access-check": "tsx scripts/access-check.ts",
    "db-schema-check": "tsx scripts/db-schema-check.ts",
    "workspace-store-check": "tsx scripts/workspace-store-check.ts",
    "sync-check": "tsx scripts/sync-check.ts",
    "pii-check": "tsx scripts/pii-check.ts",
    "server-db-check": "tsx scripts/server-db-check.ts",
    "db-smoke": "tsx scripts/db-smoke.ts",
    "seed-staging": "tsx scripts/seed-staging.ts",
    "clean:stale": "node scripts/clean-stale.mjs",
    "restore-check": "tsx scripts/restore-check.ts",
    "e2e:setup": "python3 -m venv .venv && .venv/bin/python -m pip install --quiet --upgrade pip playwright && .venv/bin/python -m playwright install chromium firefox",
    "e2e": ".venv/bin/python scripts/suite-e2e.py chromium",
    "e2e:promo": ".venv/bin/python scripts/promo-e2e.py chromium",
    "e2e:logistics": ".venv/bin/python scripts/logistics-e2e.py chromium",
    "a11y": ".venv/bin/python scripts/a11y-e2e.py",
    "responsive": ".venv/bin/python scripts/responsive-e2e.py"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  }
}
