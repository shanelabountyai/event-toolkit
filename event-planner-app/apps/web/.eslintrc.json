{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "next-env.d.ts"
  ],
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/(bg|text|border|ring|divide|from|via|to|placeholder|decoration|outline|accent|caret|fill|stroke)-(slate|gray|zinc|neutral|stone|sky|blue|indigo|violet|purple|emerald|green|teal|cyan|amber|yellow|orange|red|rose|pink|fuchsia|lime)-[0-9]{2,3}/]",
        "message": "Use a semantic token (bg-surface, text-content-muted, border-line, text-danger-text, \u2026) instead of a raw Tailwind palette colour \u2014 raw colours cannot respond to the dark theme. See app/tokens.css."
      },
      {
        "selector": "TemplateElement[value.raw=/(bg|text|border|ring|divide|from|via|to|placeholder|decoration|outline|accent|caret|fill|stroke)-(slate|gray|zinc|neutral|stone|sky|blue|indigo|violet|purple|emerald|green|teal|cyan|amber|yellow|orange|red|rose|pink|fuchsia|lime)-[0-9]{2,3}/]",
        "message": "Use a semantic token instead of a raw Tailwind palette colour. See app/tokens.css."
      }
    ]
  }
}
