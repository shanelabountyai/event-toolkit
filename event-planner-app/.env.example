# Hosted tier configuration (PRDs 8-10). NAMES ONLY — never commit a real value here.
#
# None of this is needed for local-only mode, which is the default and stays fully functional
# with no account, no network and no database. Copy to `.env.local` and fill in to run the
# hosted tier.

# --- Database (PRD 8) -------------------------------------------------------
# Postgres connection string. Vercel Postgres, Neon, or a local instance.
DATABASE_URL=

# --- Auth.js v5 (PRD 8 FR-1) ------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The deployment's own origin, e.g. https://example.com. Required in production.
AUTH_URL=

# --- Transactional email (PRD 8 FR-1, FR-6) ---------------------------------
# Resend API key, used for verification, magic links and invitations.
AUTH_RESEND_KEY=
# The From address those emails are sent from. Must be a verified domain in Resend.
EMAIL_FROM=

# --- Retention cron (PRD 10 FR-4) -------------------------------------------
# Shared secret the daily retention job presents, so the endpoint is not publicly runnable.
CRON_SECRET=
